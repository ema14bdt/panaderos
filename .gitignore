# Environment & Sensitive configuration
private-content/admin.local.php
.env

# Runtime content store (Independent per environment)
private-content/*.json
!private-content/seeds/*.json
!private-content/admin.local.example.php
private-content/*.lock
private-content/*.tmp
private-content/audit.log
private-content/login-attempts.json
private-content/backups/

# User-uploaded dynamic media (Excluded from Git so environments don't overwrite each other)
images/directivos/*-*.*
images/instalaciones/*-*.*
images/novedades/*-*.*
images/uploads/
uploads/

# OS and Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
